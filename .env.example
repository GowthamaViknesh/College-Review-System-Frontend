# --- While developing ---
# Where the Vite dev server forwards /api requests (the backend running on your machine)
VITE_API_TARGET=http://localhost:5000

# --- For a deployed build ---
# The backend's public address, with no trailing slash. Read when the site is built (npm run build),
# so set it in your hosting provider's environment settings, then rebuild.
# Leave it unset while developing, so requests go through the dev server above.
# VITE_API_URL=https://your-backend.onrender.com
